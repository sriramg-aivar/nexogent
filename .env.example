# Copy to .env for local mode (docker compose up). Never commit the real .env.
AWS_PROFILE=default
AWS_REGION=us-east-1
# Protect the portal even locally:
SUPERADMIN_PASSWORD=change-me
# A 32+ byte secret for signed sessions (openssl rand -hex 32):
SESSION_SECRET=change-me-to-a-long-random-value
# Set to true to run with synthetic data and no AWS calls:
DEMO_MODE=
